{
  "name": "cheesekit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "pnpm --filter @cheesekit/tool-sdk --filter @cheesekit/llm-gateway --filter @cheesekit/chzzk-adapter --filter @cheesekit/core --filter @cheesekit/storage --filter @cheesekit/manzai-bot build && pnpm --filter @cheesekit/desktop dev",
    "build": "pnpm -r --sort run build",
    "test": "vitest run",
    "test:desktop": "pnpm build && node scripts/run-desktop-smoke.cjs",
    "typecheck": "tsc -b",
    "lint": "node -e \"console.log('No lint configuration yet.')\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^41.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
